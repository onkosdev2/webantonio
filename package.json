{
  "name": "dr-antonio-camargo-oncologia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:postgres:up": "docker compose up -d postgres",
    "db:postgres:down": "docker compose down",
    "db:postgres:logs": "docker compose logs -f postgres",
    "db:migrate:sqlite-to-postgres": "prisma generate --schema prisma/schema.sqlite.prisma && prisma generate && node --env-file=.env --env-file-if-exists=.env.local scripts/migrate-sqlite-to-postgres.mjs",
    "db:verify:migration": "node --env-file=.env --env-file-if-exists=.env.local scripts/verify-sqlite-postgres.mjs",
    "db:optimize-news-slugs": "tsx scripts/optimize-news-slugs.ts",
    "test:mcp:e2e": "MCP_E2E_CONFIRM=1 node --env-file=.env --env-file-if-exists=.env.local scripts/mcp-e2e.mjs",
    "test:mcp:news": "node --env-file=.env --env-file-if-exists=.env.local scripts/mcp-news-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.6.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extension-table-cell": "^3.28.0",
    "@tiptap/extension-table-header": "^3.28.0",
    "@tiptap/extension-table-row": "^3.28.0",
    "@tiptap/extension-text-align": "^3.28.0",
    "@tiptap/extension-underline": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "next": "^15.3.0",
    "postcss": "^8.5.19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "turndown": "^7.2.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/turndown": "^5.0.6",
    "prisma": "^6.6.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "^8.5.19"
  }
}
