generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  CLINICAL_CASE
  EDITORIAL
  RESEARCH
  NEWS_ITEM
  STORY
  REFLECTION
  GALLERY_ASSET
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ImportState {
  RECEIVED
  VALIDATED
  QUEUED
  REVIEW_REQUIRED
  FAILED
}

enum AiTaskKind {
  NEWS_DRAFT
  EDITORIAL_DRAFT
  CASE_ENRICHMENT
  COMMENT_REPLY
}

enum AiTaskState {
  PENDING
  RUNNING
  READY
  APPLIED
}

enum VisualPlanStatus {
  PENDING
  ANALYZING
  RETRIEVING
  REASONING
  PLANNING
  PROMPTING
  COMPLIANCE_REVIEW
  QUALITY_REVIEW
  READY
  REQUIRES_REVIEW
  FAILED
  STALE
}

enum FigureStatus {
  PLANNED
  READY
  GENERATING
  GENERATED
  FAILED
  STALE
}

enum UserRole {
  ADMIN
  EDITOR
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  role               UserRole  @default(EDITOR)
  passwordHash       String?
  mustChangePassword Boolean   @default(true)
  active             Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model OAuthAuthorizationCode {
  id            String   @id
  userId        String
  clientId      String
  redirectUri   String
  codeChallenge String
  resource      String
  scope         String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}

model Content {
  id          String        @id @default(cuid())
  type        ContentType
  status      ContentStatus @default(DRAFT)
  title       String
  slug        String        @unique
  summary     String
  body        String
  source      String?
  sourceUrl   String?
  author      String?
  tags        Json          @default("[]")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?

  oncologyData OncologyMetadata?
  media        MediaAsset[]
  importLogs   ImportLog[]
  aiTasks      AiTask[]
  visualPlans  CaseVisualPlan[]
  slugAliases  ContentSlugAlias[]
}

model ContentSlugAlias {
  id        String   @id @default(cuid())
  contentId String
  slug      String   @unique
  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

model OncologyMetadata {
  id            String  @id @default(cuid())
  contentId     String  @unique
  tumorType     String?
  stage         String?
  biomarkers    Json    @default("[]")
  treatmentLine String?
  treatmentPlan String?
  response      String?
  toxicities    Json    @default("[]")
  evidenceLevel String?
  reviewNotes   String?
  anonymized    Boolean @default(false)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id          String   @id @default(cuid())
  contentId   String?
  title       String
  altText     String?
  storagePath String
  mediaType   String
  isSensitive Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  galleryOrder Int?
  caption      String?
  isGalleryUpload Boolean @default(false)
  galleryUploadHash String?
  origin      String   @default("upload")
  prompt      String?
  model       String?
  figureId    String?
  createdAt   DateTime @default(now())

  content Content?    @relation(fields: [contentId], references: [id], onDelete: SetNull)
  figure  CaseFigure? @relation(fields: [figureId], references: [id], onDelete: SetNull)

  @@index([contentId, galleryOrder])
}

model CaseVisualPlan {
  id            String           @id @default(cuid())
  contentId     String
  schemaVersion String           @default("onkos.visual-pipeline.v2")
  policyVersion String           @default("figure-policy.v1")
  sourceHash    String
  status        VisualPlanStatus @default(PENDING)
  currentStage  String           @default("privacy_validation")
  sharedState   Json
  qualityScore  Int?
  error         String?
  model         String
  isCurrent     Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  content Content      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  figures CaseFigure[]

  @@index([contentId, isCurrent])
}

model CaseFigure {
  id                     String       @id @default(cuid())
  planId                 String
  figureNumber           Int
  priority               Int
  title                  String
  category               String
  purpose                String
  educationalMessage     String
  reason                 String
  score                  Int
  adjustedScore          Int
  scoreBreakdown         Json
  supportedFacts         Json
  supportedKnowledge     Json
  recommendedVisualStyle String
  estimatedDifficulty    String
  draftPrompt            String?
  optimizedPrompt        String?
  placement              String       @default("end_of_article")
  placementAnchor        String?
  compliance             Json
  status                 FigureStatus @default(PLANNED)
  isFeatured             Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  plan   CaseVisualPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  assets MediaAsset[]

  @@unique([planId, figureNumber])
  @@index([planId, status])
}

model ImportLog {
  id             String      @id @default(cuid())
  source         String
  payloadType    String
  payloadSummary String
  state          ImportState @default(RECEIVED)
  notes          String?
  createdAt      DateTime    @default(now())
  contentId      String?

  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)
}

model AiTask {
  id          String      @id @default(cuid())
  kind        AiTaskKind
  state       AiTaskState @default(PENDING)
  title       String
  prompt      String
  resultTitle String?
  resultNote  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  contentId   String?

  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)
}
